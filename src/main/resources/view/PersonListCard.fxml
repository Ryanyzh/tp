<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<HBox id="cardPane" fx:id="cardPane" minWidth="0" prefWidth="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox spacing="9" minWidth="0" HBox.hgrow="ALWAYS">
    <HBox spacing="2" alignment="CENTER_LEFT">
      <Label fx:id="id" styleClass="cell_big_label" minWidth="-Infinity" />
      <Label fx:id="name" styleClass="cell_big_label" minWidth="0" wrapText="true" />
      <Region HBox.hgrow="ALWAYS" />
      <FlowPane fx:id="tags" maxWidth="180" />
    </HBox>
    <FlowPane hgap="14" vgap="5" minWidth="0" prefWrapLength="280" styleClass="student-details">
      <Label fx:id="studentNumber" styleClass="cell_small_label" />
      <Label fx:id="email" styleClass="cell_small_label" />
      <Label fx:id="telegram" styleClass="cell_small_label" />
    </FlowPane>
    <VBox fx:id="attendanceBox" />
  </VBox>
</HBox>
